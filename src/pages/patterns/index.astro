---
import Base from '../../layouts/Base.astro';
import Feed from '../../components/Feed.astro';
import { asTaggedPattern, getPatterns } from '../../lib/collection';

const patterns = await getPatterns();
---

<Base title="Patterns · Brief" description="Architecture patterns from Brief.">
	<p class="kicker">Collection</p>
	<h1>Patterns</h1>
	<p class="dek">
		Control patterns that sit beside the posts. Tagged patterns also appear on topic pages with
		matching posts.
	</p>
	<Feed entries={patterns.map(asTaggedPattern)} />
</Base>
