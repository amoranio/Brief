---
import Base from '../layouts/Base.astro';
import Feed from '../components/Feed.astro';
import { asTaggedPost, getPosts } from '../lib/collection';

const posts = await getPosts();
---

<Base title="Brief" description="A short publication on AI security architecture and risk.">
	<h1 class="visually-hidden">Brief</h1>
	<form class="search" role="search" action="/search/" method="get">
		<input name="q" type="search" placeholder="Search attacks: keyword, tag, or ID such as AML.T0051" aria-label="Search the library" autocomplete="off" />
	</form>
	<Feed entries={posts.map(asTaggedPost)} />
</Base>
