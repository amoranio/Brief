---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { allTags, getPosts, isoDate, postsWithTag } from '../../lib/collection';
import { formatDate } from '../../lib/dates';

export async function getStaticPaths() {
	const posts = await getCollection('posts');
	return allTags(posts).map((tag) => ({
		params: { tag },
		props: { tag },
	}));
}

interface Props {
	tag: string;
}

const { tag } = Astro.props;
const posts = postsWithTag(await getPosts(), tag);
---

<Base title={`${tag} · Brief`} description={`Posts tagged ${tag}.`}>
	<p class="date">Tag</p>
	<h1>{tag}</h1>
	<ol class="posts">
		{
			posts.map((post) => (
				<li>
					<a href={`/${post.id}/`}>
						<div class="date">
							<time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
						</div>
						<h2>{post.data.title}</h2>
						<p class="dek">{post.data.dek}</p>
					</a>
				</li>
			))
		}
	</ol>
</Base>
