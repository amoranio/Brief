---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Feed from '../../components/Feed.astro';
import { allTags, entriesWithTag, getPatterns, getPosts, taggedCatalog } from '../../lib/collection';

export async function getStaticPaths() {
	const posts = await getCollection('posts');
	const patterns = await getCollection('patterns');
	return allTags(posts, patterns).map((tag) => ({
		params: { tag },
		props: { tag },
	}));
}

interface Props {
	tag: string;
}

const { tag } = Astro.props;
const entries = entriesWithTag(taggedCatalog(await getPosts(), await getPatterns()), tag);
const patternCount = entries.filter((entry) => entry.kind === 'pattern').length;
---

<Base title={`${tag} · Brief`} description={`Posts and patterns tagged ${tag}.`}>
	<p class="kicker">Tag</p>
	<h1>{tag}</h1>
	<p class="dek">
		{entries.length} {entries.length === 1 ? 'entry' : 'entries'}
		{patternCount > 0 ? `, including ${patternCount} pattern${patternCount === 1 ? '' : 's'}` : ''}.
	</p>
	<Feed entries={entries} showKind />
</Base>
