---
/**
 * Site mark: lowercase geometric "brief" with a square i-dot.
 * Drawn as shapes so the tittle stays square on every platform.
 */
---

<svg
	class="wordmark-mark"
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 78 36"
	fill="currentColor"
	aria-hidden="true"
	focusable="false"
>
	<defs>
		<mask id="brief-b">
			<rect width="78" height="36" fill="black"></rect>
			<rect x="0" y="2.6" width="4.2" height="29.4" fill="white"></rect>
			<circle cx="11.2" cy="22.6" r="9.4" fill="white"></circle>
			<circle cx="11.35" cy="22.6" r="5.15" fill="black"></circle>
		</mask>
	</defs>

	<rect width="78" height="36" mask="url(#brief-b)"></rect>

	<!-- r -->
	<rect x="23.15" y="13.2" width="4.2" height="18.8"></rect>
	<path d="M27.35 13.2h.85c3.15 0 5.25 1.65 5.25 4.55 0 1.1-.35 2.05-1.05 2.75l-3.15-1.9c.2-.4.35-.8.35-1.25 0-1.15-.8-1.8-2.25-1.8h-.05V13.2Z"></path>

	<!-- i -->
	<rect x="36.55" y="3.15" width="4.2" height="4.2"></rect>
	<rect x="36.55" y="13.2" width="4.2" height="18.8"></rect>

	<!-- e -->
	<path
		d="M53.35 13c-5.4 0-9.6 4.2-9.6 9.6s4.2 9.6 9.6 9.6c3.55 0 6.6-1.75 8.25-4.5l-3.4-2.05c-.95 1.55-2.65 2.5-4.85 2.5-2.95 0-5.3-2.2-5.55-5.2h13.95c.08-.55.15-1.1.15-1.65 0-5.25-3.7-8.3-8.55-8.3Zm-5.4 7.45c.45-2.5 2.45-4.1 5.3-4.1s4.6 1.5 4.9 4.1h-10.2Z"
	></path>

	<!-- f -->
	<rect x="65.05" y="2.6" width="4.2" height="29.4"></rect>
	<rect x="62.55" y="13.2" width="11.2" height="3.55"></rect>
	<path d="M69.25 2.6h3.55c1.7 0 2.85 1.05 2.85 2.7v1.85h-3.2V5.55c0-.5-.3-.8-.85-.8h-2.35V2.6Z"></path>
</svg>
