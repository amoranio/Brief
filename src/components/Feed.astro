---
import type { TaggedEntry } from '../lib/collection';
import { isoDate } from '../lib/collection';
import { formatShortDate } from '../lib/dates';

interface Props {
	entries: TaggedEntry[];
	showKind?: boolean;
}

const { entries, showKind = false } = Astro.props;
---

<ol class="feed">
	{
		entries.map((entry) => (
			<li>
				<a href={entry.href}>
					{showKind && entry.kind === 'pattern' && <span class="feed-kind">Pattern</span>}
					<time class="feed-date" datetime={isoDate(entry.date)}>
						{formatShortDate(entry.date)}
					</time>
					<h2 class="feed-title">{entry.title}</h2>
					<p class="dek">{entry.dek}</p>
				</a>
			</li>
		))
	}
</ol>
